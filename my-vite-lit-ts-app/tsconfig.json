{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": false,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "experimentalDecorators": true,

    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
